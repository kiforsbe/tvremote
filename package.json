{
  "name": "tvremote",
  "version": "1.0.0",
  "description": "Samsung TV remote — Electron (Windows) + PWA (iPhone)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "test:unit": "jest tests/unit",
    "test:blackbox": "jest tests/blackbox --testTimeout=10000",
    "test:e2e": "playwright test",
    "test": "npm run test:unit"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "electron": "^31.7.7",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jimp": "^0.22.12"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
