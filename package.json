{
  "name": "tvremote",
  "version": "1.0.0",
  "description": "Samsung TV remote — Electron (Windows) + PWA (iPhone)",
  "author": "Kim Forsberg",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test:unit": "jest tests/unit",
    "test:blackbox": "jest tests/blackbox --testTimeout=10000",
    "test:e2e": "playwright test",
    "test": "npm run test:unit"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.1"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-builder": true
  },
  "build": {
    "appId": "com.kiforsbe.tvremote",
    "productName": "TV Remote",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "dialog-preload.js",
      "ip-dialog.html",
      "app/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TV Remote"
    }
  }
}
